APP_ENV=production
# Use the existing Neon URL for application and migrations during current implementation.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional later: direct endpoint on the same Neon branch/database for migrations.
DATABASE_MIGRATION_URL=
DATABASE_SSL_MODE=require
JWT_SECRET=change-me-to-a-long-random-string
INITIAL_ADMIN_USERNAME=replace-with-admin-username
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-12-plus-characters
INITIAL_ADMIN_FULL_NAME=Administrator
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
